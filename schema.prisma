// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL") // uses connection pooling
}

// Authentication (next-auth) tables

model User {
  id                  String          @id @default(cuid())
  name                String?
  email               String?         @unique
  emailVerified       DateTime?
  image               String?
  accounts            Account[]
  sessions            Session[]
  Authenticator       Authenticator[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  oauth_token_secret String?
  oauth_token        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         Int      @id @default(autoincrement())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

// DEX Tool tables

// Verdict / verification status for Pairs and Tokens.
//
// Mirrored as a string enum in types/types.ts so client components can use it
// without importing @prisma/client (which would pull the query engine into the
// browser bundle). The member names here MUST match that mirror exactly.
enum TokenPairStatus {
  Unverified
  AutoVerified
  AutoRejected
  ManualVerified
  ManualRejected
  NeedsReview
  Duplicate
  NotCurrentlyUsable
}

// How a Pair/Token reached its current status. Mirrored in types/types.ts.
enum VerificationMethod {
  Import // set at ingest, awaiting a verdict
  Manual // operator set the status directly
  Cascade // inherited from a token-status change on a sibling
  Auto // assigned by the verdict engine
}

model Pair {
  id                       String           @id @default(cuid())
  chain                    String
  dex                      String
  contractAddress          String
  token0                   Token            @relation("Token0", fields: [token0Id], references: [id])
  token0Id                 String
  token1                   Token            @relation("Token1", fields: [token1Id], references: [id])
  token1Id                 String
  pair                     String
  reserve0                 Float
  reserve1                 Float
  reserveNativeCurrency    Float
  reserveUsd               Float
  volumeUsd                Float
  marketCapUsd             Float
  priceChangePercentage24h Float
  buys24h                  Int
  sells24h                 Int
  buyers24h                Int
  sellers24h               Int
  volumeUsd24h             Float
  txCount                  Int
  token0PriceCg            Float @default(0)
  token0PriceDex           Float @default(0)
  token1PriceCg            Float @default(0)
  token1PriceDex           Float @default(0)
  status                   TokenPairStatus    @default(Unverified)
  verificationMethod       VerificationMethod @default(Import)
  verificationComment      String @default("")
  lastChecked              Int @default(0)
  createdAt                Int @default(0)
  // Verdict-engine fields (A.2). canonicalKey caches min/max of the two
  // tokens' CoinGecko coin IDs for fast cross-DEX/cross-chain sibling lookup;
  // confidence is the weighted fence score; verdictAt is the last engine run.
  canonicalKey             String?
  confidence               Float?
  verdictAt                Int @default(0)
  // The verdict engine's per-fence evidence (observed values vs thresholds),
  // surfaced on the pair detail page so the operator can audit a verdict.
  verdictEvidence          Json?
  duplicatePairs           DuplicatePairs[] @relation("OriginalPair")
  dp2                      DuplicatePairs[] @relation("DuplicatePair")

  @@index([contractAddress(sort: Desc), chain, dex])
  @@index([dex, chain])
  @@index([dex, pair])
  @@index([dex])
  @@index([token0Id])
  @@index([token1Id])
  @@index([canonicalKey])
}

model Token {
  id                    String                  @id @default(cuid())
  chain                 String
  contractAddress       String
  symbol                String
  name                  String
  status                TokenPairStatus    @default(Unverified)
  verificationMethod    VerificationMethod @default(Import)
  txCount               Int
  coingeckoCoinId       String
  totalSupply           Float
  volume24hUsd          Float
  marketCapUsd          Float
  decimals              Int
  lastChecked           Int @default(0)
  verificationComment   String @default("")
  createdAt             Int @default(0)
  // Cheap-proxy token age for the verdict engine's meetsAge fence (A.2/D7):
  // unix seconds, seeded from the oldest pool's pool_created_at. Nullable
  // until first populated.
  deploymentTimestamp   Int?
  pairsToken0           Pair[]                  @relation("Token0")
  pairsToken1           Pair[]                  @relation("Token1")
  duplicateTokenSymbols DuplicateTokenSymbols[] @relation("OriginalToken")
  dt2                   DuplicateTokenSymbols[] @relation("DuplicateToken")

  @@index([contractAddress(sort: Desc), chain])
  @@index([chain])
  @@index([symbol])
  @@index([chain, symbol])
}

model PairStaging {
  id              String @id @default(cuid())
  chain           String
  dex             String
  contractAddress String
  token0Address   String
  token1Address   String

  @@index([dex, chain])
  @@index([dex, chain, contractAddress])
  @@index([dex, chain, contractAddress, token0Address, token1Address])
}

model DuplicateTokenSymbols {
  id               Int    @id @default(autoincrement())
  originalToken    Token  @relation("OriginalToken", fields: [originalTokenId], references: [id])
  originalTokenId  String
  duplicateToken   Token  @relation("DuplicateToken", fields: [duplicateTokenId], references: [id])
  duplicateTokenId String
  chain            String

  @@index([chain])
  @@index([originalTokenId])
  @@index([duplicateTokenId])
}

model DuplicatePairs {
  id              Int    @id @default(autoincrement())
  originalPair    Pair   @relation("OriginalPair", fields: [originalPairId], references: [id])
  originalPairId  String
  duplicatePair   Pair   @relation("DuplicatePair", fields: [duplicatePairId], references: [id])
  duplicatePairId String
  chain           String
  dex             String

  @@index([chain])
  @@index([dex])
  @@index([chain, dex])
  @@index([originalPairId])
  @@index([duplicatePairId])
}

model Threshold {
  id              String @id @default(cuid())
  chain           String
  dex             String
  minLiquidityUsd Int
  minTxCount      Int
  // Verdict-engine knobs (A.3), per (chain, dex). Defaults mirror
  // DEFAULT_VERDICT_CONFIG in lib/verdict.ts so existing rows behave unchanged.
  minAgeHours              Int     @default(24)
  maxPriceDeviationPercent Float   @default(5)
  minDecimals              Int     @default(0)
  maxDecimals              Int     @default(36)
  requireCgListed          Boolean @default(false)
}

// Canonical token contract address per (CoinGecko coin id, chain), resolved
// from CoinGecko's /coins/<id>/contract/<chain> lookup. Populated lazily by
// the verdict engine on first sight of a (cgId, chain) tuple and refreshed on
// a 30d TTL (lastChecked, unix seconds). The verdict engine compares a pair's
// token contract addresses against this to catch impostor tokens that spoof a
// known symbol. See A.2.
model CanonicalAddress {
  id              String @id @default(cuid())
  coingeckoCoinId String
  chain           String
  contractAddress String
  lastChecked     Int    @default(0)

  @@unique([coingeckoCoinId, chain])
}
