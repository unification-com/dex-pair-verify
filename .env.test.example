# Integration-test environment. Copy to `.env.test` and point at a
# DEDICATED test database (NEVER the dev/prod DB — the integration suite
# truncates tables between tests).
#
# Setup:
#   createdb ooo_pairs_test     # or: psql -c "CREATE DATABASE ooo_pairs_test"
#   yarn db:push:test           # pushes schema.prisma into the test DB
#   yarn test:integration

POSTGRES_PRISMA_URL=postgres://USER:PASS@localhost:5432/ooo_pairs_test
NODE_ENV=test
