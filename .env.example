# dex-pair-verify environment. Copy to `.env` and fill in. (`.env.test.example`
# covers the separate integration-test DB.)
#
#   cp .env.example .env

# ─────────────────────────────────────────────────────────────────────────────
# Database — REQUIRED
# ─────────────────────────────────────────────────────────────────────────────
# Local Postgres. Create it first:  createdb ooo_pairs  (then: npx prisma db push)
POSTGRES_PRISMA_URL=postgres://USER:PASS@localhost:5432/ooo_pairs

# ─────────────────────────────────────────────────────────────────────────────
# Login (GitHub OAuth via next-auth) — REQUIRED to use the admin UI
# ─────────────────────────────────────────────────────────────────────────────
# Create a GitHub OAuth App:
#   https://github.com/settings/developers  →  "OAuth Apps"  →  "New OAuth App"
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# next-auth session-encryption secret. Generate one (either is fine — the
# trailing "=" from base64 is harmless; dotenv keeps the whole value):
#   openssl rand -base64 32     # 44 chars, ends with "="
#   openssl rand -hex 32        # 64 hex chars, no special characters
# Paste it unquoted, no surrounding spaces.
SECRET=

# Comma-separated GitHub usernames (or emails) allowed as admins.
ALLOWED_USERS=your-github-username

# ─────────────────────────────────────────────────────────────────────────────
# The Graph — REQUIRED for the price-test / OoO-simulation feature
# ─────────────────────────────────────────────────────────────────────────────
# The DEX subgraph price queries (lib/sources.js) use The Graph's decentralised
# network. NOT needed for ingest / the verdict pipeline (those use GeckoTerminal).
# Get a key: https://thegraph.com/studio  →  connect wallet  →  "API Keys"  →
# create. (Free dev allowance; heavy/production querying is billed in GRT.)
THEGRAPH_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# CoinGecko — OPTIONAL (recommended: speeds up ingest + canonicalcheck a lot)
# ─────────────────────────────────────────────────────────────────────────────
# Free "Demo" API key. Without it, ingest + canonicalcheck fall back to the slow
# public/shared CoinGecko rate limits (the canonical pass goes from ~minutes to
# ~30–60 min on a cold DB).
# Get one: https://www.coingecko.com/en/api/pricing  →  "Demo (free)"  →  then
#          https://www.coingecko.com/en/developers/dashboard  →  "Add New Key"
GECKO_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Etherscan — OPTIONAL (on-chain token reads)
# ─────────────────────────────────────────────────────────────────────────────
# Etherscan V2 multichain key — ONE key, switched by `chainid`. Free tier covers
# Ethereum / Polygon / Gnosis (NOT BSC — paid). Note: holder count + tokeninfo are
# Pro-only; the free tier gives supply / source / contract-creation only.
# Get one: https://etherscan.io/myapikey
ETHERSCAN_API=

# ─────────────────────────────────────────────────────────────────────────────
# Export API — OPTIONAL (only if go-ooo polls the bearer-token export endpoint)
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated bearer tokens YOU generate (e.g. `openssl rand -hex 24`).
# go-ooo sends one as `Authorization: Bearer <token>`. Rotate by adding a second.
EXPORT_API_TOKEN=
