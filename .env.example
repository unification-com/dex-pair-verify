# dex-pair-verify environment. Copy to `.env` and fill in. (`.env.test.example`
# covers the separate integration-test DB.)
#
#   cp .env.example .env

# ─────────────────────────────────────────────────────────────────────────────
# Database — REQUIRED
# ─────────────────────────────────────────────────────────────────────────────
# Local Postgres. Create it first:  createdb ooo_pairs  (then: npx prisma db push)
POSTGRES_PRISMA_URL=postgres://USER:PASS@localhost:5432/ooo_pairs

# ─────────────────────────────────────────────────────────────────────────────
# Login (GitHub OAuth via next-auth) — REQUIRED to use the admin UI
# ─────────────────────────────────────────────────────────────────────────────
# Create a GitHub OAuth App:
#   https://github.com/settings/developers  →  "OAuth Apps"  →  "New OAuth App"
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# next-auth session-encryption secret. Generate one (either is fine — the
# trailing "=" from base64 is harmless; dotenv keeps the whole value):
#   openssl rand -base64 32     # 44 chars, ends with "="
#   openssl rand -hex 32        # 64 hex chars, no special characters
# Paste it unquoted, no surrounding spaces.
SECRET=

# Operator allow-list. Entries may be GitHub *numeric user ids* (PREFERRED — immutable;
# find one at https://api.github.com/users/<login>) or account emails, in EITHER var
# below — both are merged and each entry is classified by shape (all-digits → id, else
# email). Anyone not listed is rejected at sign-in and browses as the public. A GitHub
# account with a private email has no email here, so prefer ids.
ALLOWED_GH_IDS=
ALLOWED_USERS=

# ─────────────────────────────────────────────────────────────────────────────
# The Graph — REQUIRED for the price-test / OoO-simulation feature
# ─────────────────────────────────────────────────────────────────────────────
# The DEX subgraph price queries (lib/sources.js) use The Graph's decentralised
# network. NOT needed for ingest / the verdict pipeline (those use GeckoTerminal).
# Get a key: https://thegraph.com/studio  →  connect wallet  →  "API Keys"  →
# create. (Free dev allowance; heavy/production querying is billed in GRT.)
THEGRAPH_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# CoinGecko — OPTIONAL (recommended: speeds up ingest + canonicalcheck a lot)
# ─────────────────────────────────────────────────────────────────────────────
# Free "Demo" API key. Without it, ingest + canonicalcheck fall back to the slow
# public/shared CoinGecko rate limits (the canonical pass goes from ~minutes to
# ~30–60 min on a cold DB).
# Get one: https://www.coingecko.com/en/api/pricing  →  "Demo (free)"  →  then
#          https://www.coingecko.com/en/developers/dashboard  →  "Add New Key"
GECKO_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Etherscan — OPTIONAL (on-chain token reads)
# ─────────────────────────────────────────────────────────────────────────────
# Etherscan V2 multichain key — ONE key, switched by `chainid`. Free tier covers
# Ethereum / Polygon / Gnosis (NOT BSC — paid). Note: holder count + tokeninfo are
# Pro-only; the free tier gives supply / source / contract-creation only.
# Get one: https://etherscan.io/myapikey
ETHERSCAN_API=

# ─────────────────────────────────────────────────────────────────────────────
# CoinMarketCap — OPTIONAL (a second identity aggregator for the identity pass)
# ─────────────────────────────────────────────────────────────────────────────
# Pro-API key (the free "Basic" plan works — 30 calls/min, 10k/month). Used by the
# identity check's CoinMarketCap reverse contract lookup: if CMC tracks a token's
# exact contract it's a real, listed token (a second aggregator alongside
# CoinGecko, so a token CG never matched can still be identified). Without a key
# the CMC source simply no-ops (CMC has no keyless tier).
# Get one: https://pro.coinmarketcap.com/signup  →  Dashboard  →  API Key
CMC_PRO_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Pipeline tuning — OPTIONAL
# ─────────────────────────────────────────────────────────────────────────────
# Re-check TTL (days). The slow-moving `yarn pipeline` passes (identity / canonical
# / factory / scam / review-enrich) SKIP tokens already checked within this window
# instead of re-checking the whole fleet every run — so frequent runs don't keep
# re-spending the CoinGecko / GoPlus free-tier quota on data that rarely changes.
# Default 7. Lower = fresher but more API spend; 0 = re-check everything every run.
# (Ingest always pulls fresh market data; the on-demand UI pass-runners always force
# a full check regardless of this.)
PIPELINE_RECHECK_DAYS=7

# ─────────────────────────────────────────────────────────────────────────────
# Export API — OPTIONAL (only if go-ooo polls the bearer-token export endpoint)
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated bearer tokens YOU generate (e.g. `openssl rand -hex 24`).
# go-ooo sends one as `Authorization: Bearer <token>`. Rotate by adding a second.
EXPORT_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# BEACON writer — OPTIONAL (only if running the on-chain notarisation worker)
# ─────────────────────────────────────────────────────────────────────────────
# The standalone worker (deploy/beacon-writer.sh) anchors dpv's verified set to a
# Unification Mainchain BEACON: per-minute pair+token Merkle ROOTS (heartbeat) and,
# with drip on, every pair/token LEAF + OoO fulfilment receipt — one tx per block.
# Holds a FUNDED signing key, so keep its mnemonic in a FILE (below), never inline.
# Leave this whole block unset to not run the worker.
BEACON_RPC=https://rpc.unification.io          # CometBFT RPC (http), NOT the LCD/REST
BEACON_CHAIN_ID=FUND-MainNet-2
# The registered beacon id. Run `yarn beacon-writer register` once (with the funded
# key) and paste the printed id here before starting the service.
BEACON_ID=
# Path to a file holding ONLY the signer mnemonic (chmod 600). Preferred over the
# inline literal so the key stays off the env surface the web app also loads.
BEACON_WRITER_MNEMONIC_FILE=/etc/dpv/beacon-writer.mnemonic
# BEACON_WRITER_MNEMONIC=                       # fallback inline literal (discouraged)
BEACON_INTERVAL_SEC=60                          # root-heartbeat cadence
BEACON_DRIP_ENABLED=true                        # REQUIRED for leaves + fulfilments + re-anchor to go on-chain
BEACON_DRIP_INTERVAL_SEC=6                       # drip tick (~ block time)
# After the vaxildan #129 upgrade is auto-detected (BeaconTimestampsByHash probe), re-record
# the whole pre-upgrade backlog WITH metadata. Default on; set 0 to pause just the backlog.
BEACON_REANCHOR_ENABLED=true
BEACON_RECORD_FEE=1000000000                     # 1 FUND (nund) — must cover the module fee_record
BEACON_REGISTER_FEE=1000000000000                # 1000 FUND — only used by `register`
BEACON_GAS=300000
BEACON_MONIKER=dpv-anchor
BEACON_NAME=dex-pair-verify anchor

# ─────────────────────────────────────────────────────────────────────────────
# OoO fulfilment watcher — OPTIONAL (the read-only sibling of the BEACON writer)
# ─────────────────────────────────────────────────────────────────────────────
# deploy/fulfilment-watcher.sh watches each OoO Router's RequestFulfilled event and
# enqueues a receipt hash for the writer to anchor. No signing key. Built-in chains:
# 1 eth, 137 polygon, 109 shibarium, 766 qom, 11155111 sepolia, 157 puppynet.
BEACON_WATCH_CHAINS=1,137,109,766,11155111,157  # CSV of chainIds; unset = all built-ins
BEACON_WATCH_INTERVAL_SEC=30                     # poll cadence
BEACON_WATCH_BATCH_BLOCKS=5000                   # max blocks per getLogs scan
BEACON_WATCH_CONFIRMATIONS=5                     # stay this far behind head (reorg safety)
# Per-chain overrides. Built-in RPCs are keyless public nodes — set keyed RPCs for prod.
# OOO_ROUTER_RPC_1=https://eth-mainnet.example/v2/KEY
# OOO_ROUTER_RPC_11155111=https://eth-sepolia.example/v2/KEY
# OOO_ROUTER_ADDRESS_<chainId>=0x...            # only if a Router differs from the built-in
# BEACON_WATCH_START_BLOCK_<chainId>=NNNNN       # first-run backfill floor (else starts near head)
