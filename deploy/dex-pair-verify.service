[Unit]
Description=dex-pair-verify web server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=500
StartLimitBurst=5

[Service]
Type=simple
# EDIT: the user that owns the checkout and the nvm install.
User=youruser
# EDIT: absolute path to deploy/run.sh inside your checkout.
ExecStart=/home/youruser/dex-pair-verify/deploy/run.sh
Restart=on-failure
RestartSec=5s
KillSignal=SIGINT
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
