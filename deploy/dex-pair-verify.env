# Shared configuration for the dex-pair-verify deploy scripts (run.sh, pipeline.sh).
# This file is sourced by bash, so $HOME and friends expand normally.
# The repo location is auto-detected by the scripts; you do not set it here.

# nvm-installed Node version to use (the scripts run `nvm use "$NODE_VERSION"`).
NODE_VERSION="v20.19"

# Interface and port for the web server. Loopback by default — put a reverse
# proxy in front for public access.
HOST="127.0.0.1"
PORT="6973"

# Base directory for pipeline logs; files land in $LOG_ROOT/YYYY-MM/.
LOG_ROOT="$HOME/logs"
